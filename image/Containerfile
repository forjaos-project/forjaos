COPY hero/wakeword/worker.py /usr/share/forjaos/wakeword/worker.py
COPY hero/wakeword/features.py /usr/share/forjaos/wakeword/features.py
COPY hero/wakeword/launcher.py /usr/share/forjaos/wakeword/launcher.py
COPY hero/voice-runtime/requirements.txt /usr/share/forjaos/voice-runtime/requirements.txt
COPY hero/voice-runtime/pyproject.toml /usr/share/forjaos/voice-runtime/pyproject.toml
COPY hero/voice-runtime/uv.lock /usr/share/forjaos/voice-runtime/uv.lock
COPY image/pipewire/forja-hero-echo-cancel.conf /usr/share/pipewire/pipewire.conf.d/forja-hero-echo-cancel.conf
COPY hero-memory/systemd/memd.service /usr/lib/systemd/user/memd.service
COPY hero-memory/systemd/forja-memory-git-scan.service /usr/lib/systemd/user/forja-memory-git-scan.service
COPY hero-memory/systemd/forja-memory-git-scan.timer /usr/lib/systemd/user/forja-memory-git-scan.timer
COPY hero-memory/visualizer/ /usr/share/forjaos/memory-viewer/
COPY hero-memory/kwin/forja-memory-window/ /usr/share/kwin/scripts/forja-memory-window/
COPY image/game/game_mode.py /usr/libexec/forjaos/game_mode.py
COPY image/game/hero-game.target /usr/lib/systemd/user/hero-game.target
COPY image/game/forjaos-game-session.service /usr/lib/systemd/user/forjaos-game-session.service
COPY image/game/forjaos-game-watch.service /usr/lib/systemd/user/forjaos-game-watch.service
RUN mkdir -p /usr/lib/systemd/user/graphical-session.target.wants \
    && mkdir -p /usr/lib/systemd/user/default.target.wants \
    && ln -s ../herod.service /usr/lib/systemd/user/default.target.wants/herod.service \
    && ln -s ../memd.service /usr/lib/systemd/user/default.target.wants/memd.service \
    && mkdir -p /usr/lib/systemd/user/timers.target.wants \
    && ln -s ../forja-memory-git-scan.timer /usr/lib/systemd/user/timers.target.wants/forja-memory-git-scan.timer \
    && ln -s ../forjaos-firstboot.service \
      /usr/lib/systemd/user/graphical-session.target.wants/forjaos-firstboot.service \
    && ln -s ../forjaos-game-watch.service \
      /usr/lib/systemd/user/graphical-session.target.wants/forjaos-game-watch.service

RUN install -D -m 0755 /tmp/forjaos-firstboot/setup-dual-boot.sh \
      /usr/libexec/forjaos/setup-dual-boot.sh \
    && install -D -m 0644 /tmp/forjaos-firstboot/setup-dual-boot.service \
      /usr/lib/systemd/system/forjaos-setup-dual-boot.service \
    && install -D -m 0644 /tmp/forjaos-firstboot/90-forjaos-ntfs-readonly.rules \
      /usr/lib/udev/rules.d/90-forjaos-ntfs-readonly.rules \
    && mkdir -p /usr/lib/systemd/system/multi-user.target.wants \
    && ln -s ../forjaos-setup-dual-boot.service \
      /usr/lib/systemd/system/multi-user.target.wants/forjaos-setup-dual-boot.service \
    && rm -r /tmp/forjaos-firstboot

RUN ln -s /opt/forjaos/graphify-runtime/.venv/bin/graphify /usr/bin/graphify \
    && chmod 0755 /usr/share/forjaos/hero-overlay/launcher.py \
    && ln -s /usr/share/forjaos/hero-overlay/launcher.py /usr/libexec/forjaos/hero-overlay \
    && chmod 0755 /usr/share/forjaos/hero-overlay/toggle_microphone.py \
    && ln -s /usr/share/forjaos/hero-overlay/toggle_microphone.py /usr/libexec/forjaos/hero-mic-toggle \
    && chmod 0755 /usr/share/forjaos/hero-overlay/toggle_push_to_talk.py \
    && ln -s /usr/share/forjaos/hero-overlay/toggle_push_to_talk.py /usr/libexec/forjaos/hero-ptt-toggle \
    && chmod 0755 /usr/share/forjaos/voice-runtime/launcher.py \
    && ln -s /usr/share/forjaos/voice-runtime/launcher.py /usr/libexec/forjaos/voice-worker \
    && chmod 0755 /usr/share/forjaos/voice-runtime/playback.py \
    && ln -s /usr/share/forjaos/voice-runtime/playback.py /usr/libexec/forjaos/hero-speak \
    && chmod 0755 /usr/share/forjaos/wakeword/launcher.py \
    && ln -s /usr/share/forjaos/wakeword/launcher.py /usr/libexec/forjaos/hero-wakeword \
    && test -x /usr/bin/graphify \
    && test -x /usr/libexec/forjaos/hero-overlay \
    && test -x /usr/libexec/forjaos/hero-mic-toggle \
    && test -x /usr/libexec/forjaos/hero-ptt-toggle \
    && test -x /usr/libexec/forjaos/voice-worker \
    && test -x /usr/libexec/forjaos/hero-speak \
    && test -x /usr/libexec/forjaos/hero-wakeword \
    && test -x /opt/forjaos/wakeword-runtime/.venv/bin/python

RUN python3 /tmp/configure_image.py \
      --root / \
      --public-key /tmp/forjaos.pub \
      --image-name "${IMAGE_NAME}" \
      --icons-dir /tmp/forjaos-icons \
    && python3 /tmp/configure_plasma.py --root / \
    && bash /tmp/configure_startup.sh / \
    && bash /tmp/rebuild_initramfs.sh \
    && rm /tmp/configure_image.py /tmp/configure_plasma.py /tmp/forjaos.pub /tmp/forjaos-icons/* \
    && rm /tmp/configure_startup.sh /tmp/rebuild_initramfs.sh \
    && rmdir /tmp/forjaos-icons \
    && bootc container lint \
    && python3 /usr/libexec/forjaos/check_image_contract.py
