ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-nvidia-open:stable
FROM ${BASE_IMAGE} AS branding-builder
ARG IMAGE_NAME=forjaos-nvidia-open
# Build-only: grub2-tools-extra supplies grub2-mkfont; this stage is not shipped.
RUN dnf install -y cargo rust rpm-build jetbrains-mono-fonts grub2-tools-extra qt6-linguist qt6-qtdeclarative-devel qt6-qtbase-devel kf6-krunner-devel extra-cmake-modules cmake uv python3.14 && dnf clean all
COPY hero-memory/graphify-runtime/pyproject.toml hero-memory/graphify-runtime/uv.lock /opt/forjaos/graphify-runtime/
WORKDIR /opt/forjaos/graphify-runtime
ENV UV_CACHE_DIR=/opt/forjaos/uv-cache
RUN install -d -m 0700 /var/roothome/.cargo /var/roothome/.cache /opt/forjaos/uv-cache \
    && uv sync --locked --no-dev --no-install-project --python 3.14
COPY image/build_files/generate_python_license_inventory.py /tmp/generate_python_license_inventory.py
RUN /opt/forjaos/graphify-runtime/.venv/bin/python \
      /tmp/generate_python_license_inventory.py > /tmp/THIRD_PARTY_PYTHON_LICENSES.md
COPY hero/wakeword/runtime/pyproject.toml hero/wakeword/runtime/uv.lock /opt/forjaos/wakeword-runtime/
WORKDIR /opt/forjaos/wakeword-runtime
RUN uv sync --locked --no-dev --no-install-project --python 3.14 \
    && /opt/forjaos/wakeword-runtime/.venv/bin/python \
      /tmp/generate_python_license_inventory.py > /tmp/THIRD_PARTY_WAKE_LICENSES.md
WORKDIR /
COPY cli/Cargo.toml cli/Cargo.lock /tmp/forja-cli/
COPY cli/src/ /tmp/forja-cli/src/
COPY hero/Cargo.toml hero/Cargo.lock /tmp/herod/
COPY hero/src/ /tmp/herod/src/
COPY hero/tool-policy.toml /tmp/herod/tool-policy.toml
COPY hero-memory/Cargo.toml hero-memory/Cargo.lock /tmp/memd/
COPY hero-memory/src/ /tmp/memd/src/
COPY hero-mcp/Cargo.toml hero-mcp/Cargo.lock /tmp/hero-mcp/
COPY hero-mcp/src/ /tmp/hero-mcp/src/
COPY hero-mcp/manifests/ /tmp/forjaos-mcp-manifests/
COPY hero/overlay/ /tmp/hero-overlay/
RUN qmllint-qt6 /tmp/hero-overlay/main.qml \
    && lupdate-qt6 /tmp/hero-overlay/main.qml /tmp/hero-overlay/launcher.py -ts /tmp/hero-overlay/i18n/hero-overlay_en.ts \
    && lrelease-qt6 -fail-on-unfinished /tmp/hero-overlay/i18n/hero-overlay_en.ts -qm /tmp/hero-overlay_en.qm
RUN cargo build --manifest-path /tmp/forja-cli/Cargo.toml --locked --release \
    && install -D -m 0755 /tmp/forja-cli/target/release/forja /tmp/forjaos-bin/forja \
    && install -d -m 0755 /tmp/forja-completions \
    && /tmp/forjaos-bin/forja completions bash > /tmp/forja-completions/forja.bash \
    && /tmp/forjaos-bin/forja completions zsh > /tmp/forja-completions/_forja \
    && /tmp/forjaos-bin/forja completions fish > /tmp/forja-completions/forja.fish \
    && cargo build --manifest-path /tmp/herod/Cargo.toml --locked --release \
    && install -D -m 0755 /tmp/herod/target/release/herod /tmp/forjaos-bin/herod \
    && cargo build --manifest-path /tmp/memd/Cargo.toml --locked --release \
    && install -D -m 0755 /tmp/memd/target/release/memd /tmp/forjaos-bin/memd \
    && cargo build --manifest-path /tmp/hero-mcp/Cargo.toml --locked --release --bins \
    && install -D -m 0755 /tmp/hero-mcp/target/release/hero-system /tmp/forjaos-bin/hero-system \
    && install -D -m 0755 /tmp/hero-mcp/target/release/hero-desktop /tmp/forjaos-bin/hero-desktop \
    && install -D -m 0755 /tmp/hero-mcp/target/release/hero-dev /tmp/forjaos-bin/hero-dev
COPY hero/krunner/ /tmp/hero-kde/krunner/
COPY hero/kde/CMakeLists.txt /tmp/hero-kde/CMakeLists.txt
COPY hero/plasmoid/ /tmp/hero-kde/plasmoid/
RUN dnf install -y kf6-ki18n-devel && dnf clean all
RUN cmake -S /tmp/hero-kde -B /tmp/hero-kde-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /tmp/hero-kde-build --parallel \
    && qmllint-qt6 -I /usr/lib64/qt6/qml -I /tmp/hero-kde-build/plasmoid-plugin /tmp/hero-kde/plasmoid/contents/ui/main.qml \
    && DESTDIR=/tmp/forjaos-kde-root cmake --install /tmp/hero-kde-build
COPY image/build_files/ /tmp/forjaos-build/
COPY brand/ /tmp/brand/
RUN bash /tmp/forjaos-build/build_branding_rpm.sh \
      /tmp/forjaos-build /tmp/brand/logo/png /tmp/forjaos-branding.rpm "${IMAGE_NAME}"
RUN bash /tmp/forjaos-build/build_plasma_rpm.sh \
      /tmp/forjaos-build /tmp/brand /tmp/hero-kde /tmp/forjaos-kde-root /tmp/forjaos-plasma.rpm

FROM ${BASE_IMAGE}

ARG IMAGE_NAME=forjaos-nvidia-open

RUN dnf install -y python3-pyside6 python3.14 python3-dbus libsecret pipewire-utils webrtc-audio-processing && dnf clean all \
    && rpm -q terra-gamescope terra-mangohud terra-bluez pipewire-utils webrtc-audio-processing

COPY image/build_files/remove.txt /tmp/remove.txt
COPY image/build_files/apply_package_policy.sh /tmp/apply_package_policy.sh
RUN bash /tmp/apply_package_policy.sh /tmp/remove.txt \
    && dnf clean all \
    && rm /tmp/remove.txt /tmp/apply_package_policy.sh

COPY image/build_files/install_dx_tools.sh /tmp/install_dx_tools.sh
RUN bash /tmp/install_dx_tools.sh \
    && dnf clean all \
    && rm /tmp/install_dx_tools.sh

COPY --from=branding-builder /tmp/forjaos-branding.rpm /tmp/forjaos-branding.rpm
COPY --from=branding-builder /tmp/forjaos-plasma.rpm /tmp/forjaos-plasma.rpm
COPY --from=branding-builder /tmp/forjaos-bin/forja /usr/bin/forja
COPY --from=branding-builder /tmp/forja-completions/forja.bash /usr/share/bash-completion/completions/forja
COPY --from=branding-builder /tmp/forja-completions/_forja /usr/share/zsh/site-functions/_forja
COPY --from=branding-builder /tmp/forja-completions/forja.fish /usr/share/fish/vendor_completions.d/forja.fish
COPY --from=branding-builder /tmp/forjaos-bin/herod /usr/libexec/forjaos/herod
COPY --from=branding-builder /tmp/forjaos-bin/memd /usr/libexec/forjaos/memd
COPY --from=branding-builder /tmp/forjaos-bin/hero-system /usr/libexec/forjaos/hero-system
COPY --from=branding-builder /tmp/forjaos-bin/hero-desktop /usr/libexec/forjaos/hero-desktop
COPY --from=branding-builder /tmp/forjaos-bin/hero-dev /usr/libexec/forjaos/hero-dev
COPY --from=branding-builder /tmp/forjaos-mcp-manifests/ /usr/share/forjaos/mcp-manifests/
COPY hero/overlay/ /usr/share/forjaos/hero-overlay/
COPY brand/mascot/guara-idle.svg brand/mascot/guara-thinking.svg /usr/share/forjaos/hero-overlay/mascot/
COPY --from=branding-builder /tmp/hero-overlay_en.qm /usr/share/forjaos/hero-overlay/i18n/hero-overlay_en.qm
COPY --from=branding-builder /opt/forjaos/graphify-runtime/.venv /opt/forjaos/graphify-runtime/.venv
COPY --from=branding-builder /opt/forjaos/wakeword-runtime/.venv /opt/forjaos/wakeword-runtime/.venv
COPY --from=branding-builder /tmp/THIRD_PARTY_PYTHON_LICENSES.md /usr/share/licenses/forjaos/THIRD_PARTY_PYTHON_LICENSES.md
COPY --from=branding-builder /tmp/THIRD_PARTY_WAKE_LICENSES.md /usr/share/licenses/forjaos/THIRD_PARTY_WAKE_LICENSES.md
RUN dnf install -y /tmp/forjaos-branding.rpm && dnf clean all && rm /tmp/forjaos-branding.rpm
RUN dnf install -y /tmp/forjaos-plasma.rpm \
    && dnf remove -y --no-autoremove plasma-lookandfeel-fedora f45-backgrounds-kde \
    && dnf remove -y --no-autoremove bazzite-portal \
    && dnf remove -y --no-autoremove krunner-yafti \
    && dnf remove -y --no-autoremove fedora-appstream-metadata fira-code-fonts \
    && dnf clean all && rm /tmp/forjaos-plasma.rpm
COPY image/build_files/configure_image.py /tmp/configure_image.py
COPY image/build_files/check_image_contract.py /usr/libexec/forjaos/check_image_contract.py
COPY image/build_files/configure_plasma.py /tmp/configure_plasma.py
COPY cosign.pub /tmp/forjaos.pub
COPY brand/logo/png/ /tmp/forjaos-icons/
COPY image/build_files/configure_startup.sh /tmp/configure_startup.sh
COPY image/build_files/rebuild_initramfs.sh /tmp/rebuild_initramfs.sh
COPY image/build_files/firstboot/ /tmp/forjaos-firstboot/
COPY image/firstboot/Preflight.qml /usr/share/forjaos/firstboot/Preflight.qml
COPY image/firstboot/PreflightState.js /usr/share/forjaos/firstboot/PreflightState.js
COPY image/firstboot/Wizard.qml /usr/share/forjaos/firstboot/Wizard.qml
COPY image/firstboot/firstboot.py /usr/libexec/forjaos/firstboot.py
COPY image/firstboot/setup_profile.py /usr/libexec/forjaos/setup_profile.py
COPY image/firstboot/install_homebrew.py /usr/libexec/forjaos/install_homebrew.py
COPY image/firstboot/install_vscode_devcontainers.py /usr/libexec/forjaos/install_vscode_devcontainers.py
COPY image/firstboot/keys.py /usr/libexec/forjaos/keys.py
COPY image/firstboot/install_postman.py /usr/libexec/forjaos/install_postman.py
