ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-nvidia-open:stable
FROM ${BASE_IMAGE} AS branding-builder
ARG IMAGE_NAME=forjaos-nvidia-open
# Build-only: grub2-tools-extra supplies grub2-mkfont; this stage is not shipped.
RUN dnf install -y cargo rust rpm-build jetbrains-mono-fonts grub2-tools-extra && dnf clean all
COPY cli/Cargo.toml cli/Cargo.lock /tmp/forja-cli/
COPY cli/src/ /tmp/forja-cli/src/
RUN cargo build --manifest-path /tmp/forja-cli/Cargo.toml --locked --release \
    && install -D -m 0755 /tmp/forja-cli/target/release/forja /tmp/forja
COPY image/build_files/ /tmp/forjaos-build/
COPY brand/ /tmp/brand/
RUN bash /tmp/forjaos-build/build_branding_rpm.sh \
      /tmp/forjaos-build /tmp/brand/logo/png /tmp/forjaos-branding.rpm "${IMAGE_NAME}"
RUN bash /tmp/forjaos-build/build_plasma_rpm.sh \
      /tmp/forjaos-build /tmp/brand /tmp/forjaos-plasma.rpm

FROM ${BASE_IMAGE}

ARG IMAGE_NAME=forjaos-nvidia-open

COPY image/build_files/remove.txt /tmp/remove.txt
COPY image/build_files/apply_package_policy.sh /tmp/apply_package_policy.sh
RUN bash /tmp/apply_package_policy.sh /tmp/remove.txt \
    && dnf clean all \
    && rm /tmp/remove.txt /tmp/apply_package_policy.sh

COPY image/build_files/install_dx_tools.sh /tmp/install_dx_tools.sh
RUN bash /tmp/install_dx_tools.sh \
    && dnf clean all \
    && rm /tmp/install_dx_tools.sh

COPY --from=branding-builder /tmp/forjaos-branding.rpm /tmp/forjaos-branding.rpm
COPY --from=branding-builder /tmp/forjaos-plasma.rpm /tmp/forjaos-plasma.rpm
COPY --from=branding-builder /tmp/forja /usr/bin/forja
RUN dnf install -y /tmp/forjaos-branding.rpm && dnf clean all && rm /tmp/forjaos-branding.rpm
RUN dnf install -y /tmp/forjaos-plasma.rpm \
    && dnf remove -y --no-autoremove plasma-lookandfeel-fedora f45-backgrounds-kde \
    && dnf remove -y --no-autoremove bazzite-portal \
    && dnf remove -y --no-autoremove krunner-yafti \
    && dnf remove -y --no-autoremove fedora-appstream-metadata fira-code-fonts \
    && dnf clean all && rm /tmp/forjaos-plasma.rpm
COPY image/build_files/configure_image.py /tmp/configure_image.py
COPY image/build_files/check_image_contract.py /usr/libexec/forjaos/check_image_contract.py
COPY image/build_files/configure_plasma.py /tmp/configure_plasma.py
COPY cosign.pub /tmp/forjaos.pub
COPY brand/logo/png/ /tmp/forjaos-icons/
COPY image/build_files/configure_startup.sh /tmp/configure_startup.sh
COPY image/build_files/rebuild_initramfs.sh /tmp/rebuild_initramfs.sh
COPY image/build_files/firstboot/ /tmp/forjaos-firstboot/
COPY image/firstboot/Preflight.qml /usr/share/forjaos/firstboot/Preflight.qml
COPY image/firstboot/PreflightState.js /usr/share/forjaos/firstboot/PreflightState.js

RUN install -D -m 0755 /tmp/forjaos-firstboot/setup-dual-boot.sh \
      /usr/libexec/forjaos/setup-dual-boot.sh \
    && install -D -m 0644 /tmp/forjaos-firstboot/setup-dual-boot.service \
      /usr/lib/systemd/system/forjaos-setup-dual-boot.service \
    && install -D -m 0644 /tmp/forjaos-firstboot/90-forjaos-ntfs-readonly.rules \
      /usr/lib/udev/rules.d/90-forjaos-ntfs-readonly.rules \
    && mkdir -p /usr/lib/systemd/system/multi-user.target.wants \
    && ln -s ../forjaos-setup-dual-boot.service \
      /usr/lib/systemd/system/multi-user.target.wants/forjaos-setup-dual-boot.service \
    && rm -r /tmp/forjaos-firstboot

RUN python3 /tmp/configure_image.py \
      --root / \
      --public-key /tmp/forjaos.pub \
      --image-name "${IMAGE_NAME}" \
      --icons-dir /tmp/forjaos-icons \
    && python3 /tmp/configure_plasma.py --root / \
    && bash /tmp/configure_startup.sh / \
    && bash /tmp/rebuild_initramfs.sh \
    && rm /tmp/configure_image.py /tmp/configure_plasma.py /tmp/forjaos.pub /tmp/forjaos-icons/* \
    && rm /tmp/configure_startup.sh /tmp/rebuild_initramfs.sh \
    && rmdir /tmp/forjaos-icons \
    && bootc container lint
