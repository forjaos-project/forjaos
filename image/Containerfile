COPY image/firstboot/forjaos-firstboot.service /usr/lib/systemd/user/forjaos-firstboot.service
COPY hero/systemd/herod.service /usr/lib/systemd/user/herod.service
COPY hero/systemd/ollama.service /usr/lib/systemd/user/ollama.service
COPY hero/voice-runtime/launcher.py /usr/share/forjaos/voice-runtime/launcher.py
COPY hero/voice-runtime/worker.py /usr/share/forjaos/voice-runtime/worker.py
